---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import MobileBottomBar from '~/components/MobileBottomBar.astro';
import PreLaunchBanner from '~/components/PreLaunchBanner.astro';
import LocalBusinessSchema from '~/components/LocalBusinessSchema.astro';
import SeoMeta from '~/components/SeoMeta.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  type?: 'website' | 'article';
  showPreLaunchBanner?: boolean;
}

const {
  title,
  description,
  noindex = false,
  ogImage,
  type = 'website',
  showPreLaunchBanner = true,
} = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbfaf6" />

    <SeoMeta
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
    />

    <LocalBusinessSchema />

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    {showPreLaunchBanner && <PreLaunchBanner />}
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileBottomBar />
  </body>
</html>
