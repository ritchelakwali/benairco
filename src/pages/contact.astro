---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/config/site';
import ContactIllustration from '~/components/ContactIllustration.astro';
import Icon from '~/components/Icon.astro';

const mailHref = `mailto:${site.contact.email}`;

const checklist = [
  'Je woonplaats',
  'Welke ruimte(s) het om gaat, met de afmetingen (lengte × breedte is genoeg)',
  'Of je wilt koelen, verwarmen of allebei',
  'Een foto van de kamer en van de buitenmuur waar de buitenunit kan komen',
];

const adviceSubject = 'Adviesaanvraag airco';
const adviceBody = [
  'Hallo Ben,',
  '',
  'Ik wil graag advies over een airco.',
  '',
  'Woonplaats: ',
  'Ruimte(s) en afmetingen (lengte x breedte): ',
  'Koelen, verwarmen of allebei: ',
  '',
  "Ik stuur foto's mee van de kamer en van de buitenmuur.",
  '',
  'Naam: ',
].join('\r\n');
const adviceMailHref = `${mailHref}?subject=${encodeURIComponent(adviceSubject)}&body=${encodeURIComponent(adviceBody)}`;

const dayLabels: Record<string, string> = {
  monday: 'Maandag',
  tuesday: 'Dinsdag',
  wednesday: 'Woensdag',
  thursday: 'Donderdag',
  friday: 'Vrijdag',
  saturday: 'Zaterdag',
  sunday: 'Zondag',
};
---

<BaseLayout
  title="Contact"
  description={`Neem direct contact op met Benairco via e-mail. Geen formulier, gewoon persoonlijk contact.`}
>
  <section class="py-14 md:py-20">
    <div class="container-content grid gap-12 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          Contact
        </p>
        <h1 class="mt-2 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
          Mail Ben gewoon
        </h1>
        <p class="mt-5 max-w-prose text-lg">
          De snelste manier om antwoord te krijgen is een e-mail. Ben leest
          elke mail zelf en antwoordt persoonlijk, geen secretariaat, geen menu.
        </p>
        <p class="mt-3 max-w-prose text-[0.95rem] text-[var(--color-muted)]">
          Een formulier vind je hier expres niet. Vertel in je mail kort wat je
          zoekt, dan plant Ben een vrijblijvende opname bij je thuis.
        </p>

        <div class="mt-7 space-y-3">
          <a
            href={mailHref}
            class="flex items-center gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-5 transition-colors hover:bg-[var(--color-primary-50)]"
          >
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-[var(--color-primary-700)] text-white">
              <Icon name="mail" class="size-5" />
            </span>
            <span class="flex-1">
              <span class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">
                E-mail
              </span>
              <span class="block font-serif text-lg break-all text-[var(--color-primary-900)]">
                {site.contact.email}
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="aspect-[8/9] w-full overflow-hidden rounded-[var(--radius-image)] border border-[var(--color-border)]">
        <ContactIllustration />
      </div>
    </div>

    <div id="meesturen" class="container-content mt-16 scroll-mt-6">
      <div class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-6 md:p-8">
        <h2 class="font-serif text-xl text-[var(--color-primary-900)]">
          Handig om mee te sturen
        </h2>
        <p class="mt-2 max-w-prose text-[0.95rem] text-[var(--color-muted)]">
          Hoe meer Ben vooraf weet, hoe gerichter het eerste advies. Niets
          hiervan is verplicht; alleen je vraag mailen mag ook.
        </p>
        <ul class="mt-5 grid gap-3 text-[0.95rem] md:grid-cols-2">
          {
            checklist.map((item) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-[var(--color-primary-700)]" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a href={adviceMailHref} class="btn-secondary mt-6">
          <Icon name="mail" class="size-4" />
          Open een mail met deze punten
        </a>
      </div>
    </div>

    <div class="container-content mt-16 grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="font-serif text-xl text-[var(--color-primary-900)]">Openingstijden</h2>
        <ul class="mt-4 divide-y divide-[var(--color-border)] rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white">
          {
            Object.entries(site.hours).map(([day, hours]) => (
              <li class="flex items-center justify-between px-5 py-3 text-[0.95rem]">
                <span class="font-medium">{dayLabels[day]}</span>
                <span class="text-[var(--color-muted)]">
                  {hours === 'closed' ? 'Gesloten' : (hours as string).replace('-', ' – ')}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-serif text-xl text-[var(--color-primary-900)]">Vestigingsadres</h2>
        <address class="mt-4 not-italic rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-5 text-[0.95rem] leading-7">
          <strong>{site.name}</strong><br />
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}<br />
          {site.address.country === 'NL' ? 'Nederland' : site.address.country}
        </address>
        <p class="mt-3 text-xs text-[var(--color-muted)]">
          KvK {site.business.kvk}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
