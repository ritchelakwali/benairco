---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/config/site';
import OverBenIllustration from '~/components/OverBenIllustration.astro';
---

<BaseLayout
  title="Over Ben"
  description={`${site.owner.name}, eigenaar van Benairco, plaatst al jaren airco's bij particulieren in de Achterhoek en Twente.`}
>
  <article class="py-14 md:py-20">
    <div class="container-content grid gap-12 md:grid-cols-[2fr_3fr] md:items-center">
      <div class="aspect-[4/5] w-full overflow-hidden rounded-[var(--radius-image)] border border-[var(--color-border)]">
        <OverBenIllustration />
      </div>

      <div class="prose-readable">
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          De mens achter Benairco
        </p>
        <h1 class="mt-2 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
          {site.owner.name}, {site.address.city}
        </h1>

        <p class="mt-6">
          Ben is geboren en getogen in de Achterhoek en plaatst al jaren airco's
          bij particulieren in de regio. De afgelopen jaren als onderaannemer voor
          andere installatiebedrijven, sinds 2024 onder zijn eigen merk Benairco.
        </p>

        <p>
          Ben doet alles zelf: het eerste gesprek, de opname bij je thuis, de
          installatie en het onderhoud daarna. Je hebt dus steeds met dezelfde
          persoon te maken.
        </p>

        <p>
          Benairco is STEK-gecertificeerd. Airco's en warmtepompen met
          koudemiddel worden dus volgens de F-gassenregels geplaatst,
          gevuld en onderhouden, met de bijbehorende registratie.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
