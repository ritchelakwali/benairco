---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pagina niet gevonden"
  description="Deze pagina bestaat niet (meer)."
  noindex={true}
  showPreLaunchBanner={false}
>
  <section class="py-20 md:py-28">
    <div class="container-content max-w-xl text-center">
      <p class="font-serif text-7xl text-[var(--color-primary-700)]">404</p>
      <h1 class="mt-4 font-serif text-2xl text-[var(--color-primary-900)]">
        Deze pagina is er niet
      </h1>
      <p class="mt-3 text-[var(--color-muted)]">
        Misschien staat het in de kennisbank, of begin opnieuw vanaf de homepage.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Naar de homepage</a>
        <a href="/kennisbank" class="btn-secondary">Kennisbank</a>
      </div>
    </div>
  </section>
</BaseLayout>
