---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NotFoundIllustration from '~/components/NotFoundIllustration.astro';
---

<BaseLayout
  title="Pagina niet gevonden"
  description="Deze pagina bestaat niet (meer)."
  noindex={true}
  showPreLaunchBanner={false}
>
  <section class="py-16 md:py-24">
    <div class="container-content grid items-center gap-12 md:grid-cols-[3fr_4fr]">
      <div class="mx-auto w-full max-w-md md:order-2">
        <NotFoundIllustration />
      </div>

      <div class="md:order-1">
        <p class="font-serif text-7xl text-[var(--color-primary-700)]">404</p>
        <h1 class="mt-4 font-serif text-2xl text-[var(--color-primary-900)] md:text-3xl">
          Deze pagina is er niet (meer)
        </h1>
        <p class="mt-3 max-w-prose text-[var(--color-muted)]">
          Soms hangt iets los, soms is een link verouderd. Begin opnieuw vanaf de
          homepage of bekijk de kennisbank.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/" class="btn-primary">Naar de homepage</a>
          <a href="/kennisbank" class="btn-secondary">Kennisbank</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
