---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';

interface Model {
  name: string;
  type: 'single-split' | 'multi-split' | 'lucht-lucht warmtepomp';
  capaciteitKw: string;
  scop?: string;
  geluidsniveauDb: string;
  geschiktVoor: string;
  highlight?: string;
}

interface Brand {
  name: string;
  karakter: string;
  body: string;
  modellen: Model[];
}

