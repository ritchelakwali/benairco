---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/config/site';
import BlogHeroIllustration from '~/components/BlogHeroIllustration.astro';
import CategoryBadge from '~/components/CategoryBadge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: site.owner.name,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/kennisbank/${post.id}`, site.url).toString(),
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(articleSchema)}
    is:inline
  />

  <article class="py-12 md:py-16">
    <div class="container-content max-w-3xl">
      <nav aria-label="Broodkruimels" class="text-sm text-[var(--color-muted)]">
        <a href="/kennisbank" class="hover:underline">Kennisbank</a>
        <span class="mx-2">/</span>
        <CategoryBadge category={post.data.category} />
      </nav>

      <h1 class="mt-4 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
        {post.data.title}
      </h1>

      <p class="mt-3 text-sm text-[var(--color-muted)]">
        {dateFormatter.format(post.data.pubDate)}
        {
          post.data.updatedDate && (
            <>
              {' '}
              · bijgewerkt {dateFormatter.format(post.data.updatedDate)}
            </>
          )
        }
      </p>

      <div
        class="mt-8 aspect-[16/7] overflow-hidden rounded-[var(--radius-image)] border border-[var(--color-border)]"
      >
        <BlogHeroIllustration category={post.data.category} />
      </div>
    </div>

    <div class="container-content mt-10">
      <div class="prose-readable">
        <Content />
      </div>

      <hr class="my-12 border-[var(--color-border)] mx-auto max-w-[38rem]" />

      <aside class="prose-readable rounded-[var(--radius-card)] bg-[var(--color-primary-50)] p-6 max-w-[38rem]">
        <h2 class="font-serif text-xl text-[var(--color-primary-900)]">
          Vragen over dit onderwerp?
        </h2>
        <p class="mt-2 text-[0.95rem]">
          Wij leggen het persoonlijk uit aan de keukentafel of per mail. Stuur
          ons gerust een berichtje via
          {' '}<a href={`mailto:${site.contact.email}`} class="font-semibold underline">
            {site.contact.email}
          </a>.
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>
