---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: site.owner.name,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/kennisbank/${post.id}`, site.url).toString(),
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(articleSchema)}
    is:inline
  />

  <article class="py-14 md:py-20">
    <div class="container-content prose-readable">
      <nav aria-label="Broodkruimels" class="text-sm text-[var(--color-muted)]">
        <a href="/kennisbank" class="hover:underline">Kennisbank</a> /{' '}
        <span class="text-[var(--color-ink)]">{post.data.category}</span>
      </nav>

      <h1 class="mt-3 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
        {post.data.title}
      </h1>

      <p class="mt-3 text-sm text-[var(--color-muted)]">
        {dateFormatter.format(post.data.pubDate)}
        {
          post.data.updatedDate && (
            <>
              {' '}
              · bijgewerkt {dateFormatter.format(post.data.updatedDate)}
            </>
          )
        }
      </p>

      <div class="mt-8">
        <Content />
      </div>

      <hr class="my-12 border-[var(--color-border)]" />

      <aside class="rounded-[var(--radius-card)] bg-[var(--color-primary-50)] p-6">
        <h2 class="font-serif text-xl text-[var(--color-primary-900)]">
          Vragen over dit onderwerp?
        </h2>
        <p class="mt-2 text-[0.95rem]">
          Ben legt het persoonlijk uit aan de keukentafel of telefonisch. Bel
          {' '}<a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="font-semibold underline">
            {site.contact.phoneDisplay}
          </a>{' '}
          of stuur een WhatsApp.
        </p>
      </aside>
    </div>
  </article>
</BaseLayout>
