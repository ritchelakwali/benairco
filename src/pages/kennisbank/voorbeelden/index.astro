---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '~/components/ProjectCard.astro';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Installatie-voorbeelden per woningtype"
  description="Hoe een airco-installatie er typisch uitziet bij verschillende soorten woningen in de Achterhoek en Twente, rijtjeswoningen, vrijstaande huizen, boerderijen, nieuwbouw."
>
  <section class="py-14 md:py-20">
    <div class="container-content">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Broodkruimels" class="text-sm text-[var(--color-muted)]">
          <a href="/kennisbank" class="hover:underline">Kennisbank</a>
          <span class="mx-2">/</span>
          <span>Voorbeelden</span>
        </nav>

        <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          Voorbeelden per woningtype
        </p>
        <h1 class="mt-2 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
          Hoe een airco-installatie er bij verschillende woningen uitziet
        </h1>
        <p class="mt-5 text-lg leading-7">
          Een Mitsubishi single-split in een Doetinchemse rijtjeswoning werkt anders
          dan een Daikin multi-split in een vrijstaand huis in Wehl. Hieronder
          uitwerkingen per woningtype en plaats.
        </p>
      </div>

      <ul class="mx-auto mt-14 max-w-3xl space-y-5">
        {
          projects.map((project) => (
            <li>
              <ProjectCard
                id={project.id}
                title={project.data.title}
                description={project.data.description}
                location={project.data.location}
                woningtype={project.data.woningtype}
                bouwjaar={project.data.bouwjaar}
                toestel={project.data.toestel}
                type={project.data.type}
                capaciteit={project.data.capaciteit}
                aantalUnits={project.data.aantalUnits}
                doorlooptijd={project.data.doorlooptijd}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
