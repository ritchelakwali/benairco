---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '~/components/ProjectCard.astro';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byType = {
  'single-split': projects.filter((p) => p.data.type === 'single-split'),
  'multi-split': projects.filter((p) => p.data.type === 'multi-split'),
  'lucht-lucht warmtepomp': projects.filter(
    (p) => p.data.type === 'lucht-lucht warmtepomp',
  ),
};
---

<BaseLayout
  title="Installatie-voorbeelden per woningtype"
  description="Hoe een airco-installatie er typisch uitziet bij verschillende soorten woningen in de Achterhoek — rijtjeswoningen, vrijstaande huizen, boerderijen, nieuwbouw."
>
  <section class="py-14 md:py-20">
    <div class="container-content">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Broodkruimels" class="text-sm text-[var(--color-muted)]">
          <a href="/kennisbank" class="hover:underline">Kennisbank</a>
          <span class="mx-2">/</span>
          <span>Voorbeelden</span>
        </nav>

        <p class="mt-4 text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          Voorbeelden per woningtype
        </p>
        <h1 class="mt-2 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
          Hoe een airco-installatie er bij verschillende woningen uitziet
        </h1>
        <p class="mt-5 text-lg leading-7">
          Een Mitsubishi single-split in een Doetinchemse rijtjeswoning werkt anders
          dan een Daikin multi-split in een vrijstaand huis in Wehl. Hieronder
          uitwerkingen per woningtype en plaats — toestel, capaciteit, doorlooptijd
          en de aandachtspunten die typisch in dat soort woningen voorkomen.
        </p>
        <p class="mt-3 text-[var(--color-muted)]">
          Educatief bedoeld: lees dit als "wat houdt het in voor mijn type woning",
          niet als portfolio. Concrete projecten met foto's volgen zodra Ben
          klant-toestemming heeft.
        </p>
      </div>

      <div class="mt-14 space-y-16">
        {
          Object.entries(byType).map(
            ([type, items]) =>
              items.length > 0 && (
                <div>
                  <div class="mx-auto max-w-3xl">
                    <h2 class="font-serif text-2xl text-[var(--color-primary-900)]">
                      {type === 'single-split'
                        ? 'Single-split installaties'
                        : type === 'multi-split'
                          ? 'Multi-split installaties'
                          : 'Lucht-lucht warmtepompen'}
                    </h2>
                    <p class="mt-2 text-sm text-[var(--color-muted)]">
                      {type === 'single-split'
                        ? 'Eén binnenunit, één buitenunit. Veruit de meest voorkomende oplossing voor één hoofdruimte.'
                        : type === 'multi-split'
                          ? 'Meerdere binnenunits delen één buitenunit. Voor wie meerdere ruimtes wil klimatiseren zonder meerdere buitenunits aan de gevel.'
                          : "Airco's met warmtefunctie die ook in de tussenseizoenen efficiënt verwarmen — komen in aanmerking voor ISDE-subsidie."}
                    </p>
                  </div>
                  <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                    {items.map((project) => (
                      <li>
                        <ProjectCard
                          id={project.id}
                          title={project.data.title}
                          description={project.data.description}
                          location={project.data.location}
                          woningtype={project.data.woningtype}
                          bouwjaar={project.data.bouwjaar}
                          toestel={project.data.toestel}
                          type={project.data.type}
                          capaciteit={project.data.capaciteit}
                          aantalUnits={project.data.aantalUnits}
                          doorlooptijd={project.data.doorlooptijd}
                          isVoorbeeld={false}
                          baseUrl="/kennisbank/voorbeelden"
                        />
                      </li>
                    ))}
                  </ul>
                </div>
              ),
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
