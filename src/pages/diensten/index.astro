---
import BaseLayout from '~/layouts/BaseLayout.astro';

// Deze pagina is alleen actief vanaf hard-launch. Tot die tijd: noindex en niet in nav.
const services = [
  {
    href: '/diensten/installatie',
    title: 'Installatie',
    body: 'Single-split, multi-split of een lucht-lucht warmtepomp, Ben kiest met je mee wat past bij je huis en gebruik.',
  },
  {
    href: '/diensten/onderhoud',
    title: 'Onderhoud',
    body: 'Jaarlijks onderhoud en de verplichte F-gassen-controle: schoon werk, eerlijke prijs.',
  },
];
---

<BaseLayout
  title="Diensten"
  description="Installatie, onderhoud en F-gassen-controle van airco's voor particulieren in de Achterhoek."
  noindex={true}
>
  <section class="py-14 md:py-20">
    <div class="container-content max-w-3xl">
      <h1 class="font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
        Diensten
      </h1>
      <p class="mt-5 text-lg">
        Benairco levert installatie en onderhoud van airco's voor particulieren.
      </p>
    </div>

    <div class="container-content mt-10 grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <a
            href={s.href}
            class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-6 transition-colors hover:bg-[var(--color-primary-50)]"
          >
            <h2 class="font-serif text-xl text-[var(--color-primary-900)]">{s.title}</h2>
            <p class="mt-2 text-[0.95rem]">{s.body}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
