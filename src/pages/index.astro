---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/config/site';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '~/components/Icon.astro';
import ProcessTimeline from '~/components/ProcessTimeline.astro';
import BrandsSection from '~/components/BrandsSection.astro';
import Faq from '~/components/Faq.astro';
import CategoryBadge from '~/components/CategoryBadge.astro';
import livingroomHero from '~/assets/hero/livingroom.jpg';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const phoneHref = `tel:${site.contact.phone.replace(/\s/g, '')}`;
const whatsappHref = `https://wa.me/${site.contact.whatsapp}`;

const heroBadges = [
  `Start dienstverlening ${site.business.expectedHardLaunchLabel}`,
  '1 uur rondom Gaanderen',
  'Persoonlijk advies bij je thuis',
];

const pillars = [
  {
    icon: 'heart' as const,
    title: 'Persoonlijk',
    body: 'Een vast team van vakmensen die elkaar al jaren kennen. Geen callcenter, geen tussenpersonen.',
  },
  {
    icon: 'check' as const,
    title: 'Netjes',
    body: 'Vloer afgedekt, gaten zorgvuldig afgewerkt, alles opgeruimd vertrokken. Werk bij jou thuis hoort net zo netjes te zijn als je het zelf zou doen.',
  },
  {
    icon: 'leaf' as const,
    title: 'Betaalbaar',
    body: 'Eerlijke prijzen zonder verrassingen achteraf. A-merken scherp ingekocht, ZZP-overhead die past bij wat je krijgt, geen kantoorpand-toeslag.',
  },
];

const dateFormatter = new Intl.DateTimeFormat('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={site.name}
  description={`Persoonlijke airco-installatie in de Achterhoek. Een klein team van zelfstandige vakmensen rond Ben Vriezen uit Gaanderen. Start dienstverlening ${site.business.expectedHardLaunchLabel}, tot dan welkom voor advies en kennismaking.`}
>
  <!-- HERO with photo + gradient overlay -->
  <section class="relative isolate overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 -z-20">
      <Image
        src={livingroomHero}
        alt="Moderne woonkamer met wandmodel-airco, Benairco-stijl installatie"
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
        style="object-position: center 35%;"
      />
    </div>

    <!-- Gradient overlay: donker links waar tekst staat, transparanter rechts -->
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-[var(--color-primary-900)]/90 via-[var(--color-primary-900)]/70 to-[var(--color-primary-900)]/20"
      aria-hidden="true"
    >
    </div>
    <!-- Verticale extra overlay voor mobiele leesbaarheid onderaan -->
    <div
      class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-gradient-to-t from-[var(--color-primary-900)]/80 to-transparent md:hidden"
      aria-hidden="true"
    >
    </div>

    <div class="container-content py-20 text-white md:py-28 lg:py-32">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-sm">
          <span class="inline-block size-1.5 rounded-full bg-[var(--color-accent)]"></span>
          Airco in de Achterhoek
        </p>
        <h1 class="mt-5 font-serif text-4xl leading-[1.1] text-white md:text-[3.5rem]">
          Persoonlijke airco-installateur
          <span class="text-[var(--color-accent)]">aan huis.</span>
        </h1>
        <p class="mt-5 max-w-prose text-lg leading-7 text-white/90">
          Een klein vast team van zelfstandige vakmensen uit Gaanderen. Wij
          installeren airco's bij particulieren in de hele Achterhoek, netjes
          en eerlijk geprijsd.
        </p>

        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-[0.95rem] text-white/90">
          {
            heroBadges.map((badge) => (
              <li class="inline-flex items-center gap-2">
                <Icon name="check" class="size-4 text-[var(--color-accent)]" />
                {badge}
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href={phoneHref} class="btn-primary">
            <Icon name="phone" class="size-4" />
            Plan een adviesgesprek
          </a>
          <a
            href={whatsappHref}
            class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] border border-white/40 bg-white/5 px-6 py-3.5 font-semibold text-white backdrop-blur-sm transition-colors hover:bg-white/15"
            rel="noopener"
          >
            <Icon name="whatsapp" class="size-4" />
            WhatsApp
          </a>
          <a
            href="/over-ons"
            class="inline-flex items-center gap-1 text-sm font-semibold text-white hover:text-[var(--color-accent)]"
          >
            Meer over Benairco
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="bg-white py-16 md:py-24">
    <div class="container-content">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          Waarom Benairco
        </p>
        <h2 class="mt-2 font-serif text-2xl text-[var(--color-primary-900)] md:text-3xl">
          Drie dingen die wij anders doen
        </h2>
      </div>

      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {
          pillars.map((p) => (
            <li class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-paper)] p-7">
              <div class="grid size-11 place-items-center rounded-full bg-[var(--color-primary-50)] text-[var(--color-primary-700)]">
                <Icon name={p.icon} class="size-5" />
              </div>
              <h3 class="mt-5 font-serif text-xl text-[var(--color-primary-900)]">
                {p.title}
              </h3>
              <p class="mt-2 text-[0.95rem] leading-6 text-[var(--color-ink)]">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- PROCESS TIMELINE -->
  <ProcessTimeline />

  <!-- BRANDS -->
  <BrandsSection />

  <!-- WERKGEBIED TEASER (rustige variant) -->
  <section class="bg-[var(--color-paper)] py-16 md:py-24">
    <div class="container-content grid gap-12 md:grid-cols-[2fr_3fr] md:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          Werkgebied
        </p>
        <h2 class="mt-2 font-serif text-2xl text-[var(--color-primary-900)] md:text-3xl">
          Alles binnen één uur rijden vanaf Gaanderen
        </h2>
        <p class="mt-3 max-w-prose text-[var(--color-ink)]">
          Van Doetinchem tot Winterswijk, van Zutphen tot Zevenaar.
          {site.serviceArea.excluded.length > 0 && (
            <span> Uitzondering: {site.serviceArea.excluded.join(', ')}.</span>
          )}
        </p>
        <a
          href="/werkgebied"
          class="mt-5 inline-flex items-center gap-1.5 font-semibold text-[var(--color-accent-600)] hover:underline"
        >
          Bekijk alle plaatsen
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
      <ul class="flex flex-wrap gap-2">
        {
          site.serviceArea.cities.slice(0, 22).map((city) => (
            <li class="rounded-full border border-[var(--color-border)] bg-white px-3 py-1 text-sm text-[var(--color-muted)]">
              {city}
            </li>
          ))
        }
        {site.serviceArea.cities.length > 22 && (
          <li class="rounded-full bg-[var(--color-primary-50)] px-3 py-1 text-sm text-[var(--color-primary-900)]">
            + {site.serviceArea.cities.length - 22} meer
          </li>
        )}
      </ul>
    </div>
  </section>

  <!-- KENNISBANK -->
  {
    posts.length > 0 && (
      <section class="bg-white py-16 md:py-24">
        <div class="container-content">
          <div class="mx-auto max-w-2xl text-center">
            <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
              Kennisbank
            </p>
            <h2 class="mt-2 font-serif text-2xl text-[var(--color-primary-900)] md:text-3xl">
              Eerlijke uitleg, geen verkooppraat
            </h2>
          </div>

          <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {posts.map((post) => (
              <li class="overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-paper)]">
                <a href={`/kennisbank/${post.id}`} class="flex h-full flex-col p-6">
                  <CategoryBadge category={post.data.category} />
                  <h3 class="mt-2 flex-1 font-serif text-lg leading-snug text-[var(--color-primary-900)]">
                    {post.data.title}
                  </h3>
                  <p class="mt-3 line-clamp-3 text-sm text-[var(--color-muted)]">
                    {post.data.description}
                  </p>
                  <p class="mt-4 text-xs text-[var(--color-muted)]">
                    {dateFormatter.format(post.data.pubDate)}
                  </p>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-10 text-center">
            <a
              href="/kennisbank"
              class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent-600)] hover:underline"
            >
              Alle artikelen
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  <Faq />

  <!-- CONTACT CTA -->
  <section class="py-16 md:py-24">
    <div class="container-content">
      <div class="mx-auto max-w-2xl rounded-[var(--radius-card)] bg-[var(--color-primary-900)] p-10 text-center text-white md:p-14">
        <h2 class="font-serif text-2xl text-white md:text-3xl">
          Vragen over je airco-mogelijkheden?
        </h2>
        <p class="mx-auto mt-4 max-w-prose text-[0.95rem] text-white/80">
          Wij staan persoonlijk klaar voor algemene vragen, vrijblijvend advies
          en voorlopige reserveringen, ook nu, in de aanloop naar de opening
          in {site.business.expectedHardLaunchLabel}.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={phoneHref} class="btn-primary">
            <Icon name="phone" class="size-4" />
            {site.contact.phoneDisplay}
          </a>
          <a
            href={whatsappHref}
            class="inline-flex items-center justify-center gap-2 rounded-[var(--radius-button)] border border-white/30 px-6 py-3.5 font-semibold text-white transition-colors hover:bg-white/10"
            rel="noopener"
          >
            <Icon name="whatsapp" class="size-4" />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
