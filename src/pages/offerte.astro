---
import BaseLayout from '~/layouts/BaseLayout.astro';

// Activeren bij hard-launch. Endpoint wordt later toegevoegd (Formspree of Firebase Functions).
// Tot die tijd noindex, niet in nav, formulier verstuurt nog nergens naartoe.
---

<BaseLayout
  title="Offerte aanvragen"
  description="Vraag een vrijblijvende offerte aan voor een airco-installatie bij jou thuis."
  noindex={true}
>
  <section class="py-14 md:py-20">
    <div class="container-content max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
        Offerte
      </p>
      <h1 class="mt-2 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
        Vraag een vrijblijvende offerte aan
      </h1>
      <p class="mt-5">
        Vul onderstaand formulier in. Ben neemt binnen één werkdag persoonlijk contact
        met je op om langs te komen voor een gratis kennismaking en opname.
      </p>

      <form
        method="POST"
        action="#"
        class="mt-10 grid gap-5 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-6"
      >
        <p class="rounded bg-[var(--color-primary-50)] p-3 text-xs text-[var(--color-primary-900)]">
          <strong>TODO:</strong> formulier-endpoint koppelen (Formspree of Firebase
          Function) vóór hard-launch.
        </p>

        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Naam</span>
          <input
            type="text"
            name="name"
            required
            class="rounded-[var(--radius-button)] border border-[var(--color-border)] px-3 py-2"
          />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Telefoon</span>
          <input
            type="tel"
            name="phone"
            required
            class="rounded-[var(--radius-button)] border border-[var(--color-border)] px-3 py-2"
          />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">E-mailadres</span>
          <input
            type="email"
            name="email"
            required
            class="rounded-[var(--radius-button)] border border-[var(--color-border)] px-3 py-2"
          />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Plaats</span>
          <input
            type="text"
            name="city"
            required
            class="rounded-[var(--radius-button)] border border-[var(--color-border)] px-3 py-2"
          />
        </label>

        <label class="grid gap-1.5 text-sm">
          <span class="font-medium">Wat voor airco zoek je?</span>
          <textarea
            name="message"
            rows="4"
            class="rounded-[var(--radius-button)] border border-[var(--color-border)] px-3 py-2"
            placeholder="Aantal kamers, soort woning, doel (alleen koelen / ook verwarmen), bijzonderheden..."
          ></textarea>
        </label>

        <button type="submit" class="btn-primary w-full justify-center">
          Verstuur aanvraag
        </button>

        <p class="text-xs text-[var(--color-muted)]">
          Je gegevens worden alleen gebruikt om met je in contact te treden over deze
          aanvraag. Zie ook ons <a href="/privacy" class="underline">privacy-beleid</a>.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>
