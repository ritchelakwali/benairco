---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/config/site';
import WerkgebiedMap from '~/components/WerkgebiedMap.astro';
import Icon from '~/components/Icon.astro';

const cities = site.serviceArea.cities;
const excluded = site.serviceArea.excluded;
---

<BaseLayout
  title="Werkgebied"
  description={`Benairco werkt in heel de Achterhoek en omstreken — alles binnen één uur rijden vanaf Gaanderen. ${cities.length} plaatsen in de regio.`}
>
  <section class="py-14 md:py-20">
    <div class="container-content grid gap-12 md:grid-cols-[3fr_4fr] md:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
          Werkgebied
        </p>
        <h1 class="mt-2 font-serif text-3xl text-[var(--color-primary-900)] md:text-4xl">
          Alles binnen één uur rijden vanaf Gaanderen
        </h1>
        <p class="mt-5 text-lg leading-7">
          Benairco bedient particulieren in de Achterhoek en de directe omgeving — van
          Doetinchem tot Winterswijk, van Zutphen tot Zevenaar, en de aanliggende
          Liemers.
        </p>
        <p class="mt-3 text-[var(--color-muted)]">
          Onderstaande kaart is een sfeer-impressie, niet geografisch precies. Staat
          jouw plaats er niet bij en woon je binnen het uur vanaf Gaanderen, neem
          gerust vrijblijvend contact op.
        </p>

        <h2 class="mt-8 font-serif text-xl text-[var(--color-primary-900)]">
          Typische Achterhoekse woningen
        </h2>
        <p class="mt-2 text-[0.95rem]">
          Veel woningen in de regio brengen specifieke installatie-uitdagingen mee.
          Een paar voorbeelden die we vaak tegenkomen:
        </p>
        <ul class="mt-3 space-y-2 text-[0.95rem]">
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-[var(--color-accent-600)]" />
            <span>
              <strong>Rijtjeswoningen jaren '70 (Doetinchem, Wehl, Didam):</strong>
              {' '}spouwmuur-doorvoer, ruimte voor leidingwerk via achtertuin.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-[var(--color-accent-600)]" />
            <span>
              <strong>Vooroorlogse boerderijen (buitengebied Vorden, Ruurlo, Zelhem):</strong>
              {' '}matige isolatie vraagt om extra leidingisolatie en zorgvuldige
              ventilatieplaatsing.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-[var(--color-accent-600)]" />
            <span>
              <strong>Nieuwbouw (Didam, Zevenaar, 's-Heerenberg):</strong>
              {' '}goed geïsoleerd, leidingdoorvoeren vaak al voorbereid — snelle
              installatie mogelijk.
            </span>
          </li>
          <li class="flex items-start gap-2">
            <Icon name="check" class="mt-1 size-4 shrink-0 text-[var(--color-accent-600)]" />
            <span>
              <strong>2-onder-1-kap en rijwoningen (Zutphen, Arnhem-Oost):</strong>
              {' '}dichtbij buren — geluidsplaatsing van de buitenunit is hier
              extra belangrijk.
            </span>
          </li>
        </ul>
        <p class="mt-4 text-sm text-[var(--color-muted)]">
          Zie ook onze <a href="/kennisbank/voorbeelden" class="font-semibold text-[var(--color-accent-600)] hover:underline">installatie-voorbeelden per woningtype</a> in de kennisbank.
        </p>

        {
          excluded.length > 0 && (
            <p class="mt-6 inline-flex items-start gap-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-4 text-sm">
              <Icon name="route" class="size-5 shrink-0 text-[var(--color-accent-600)]" />
              <span>
                <strong>Uitzondering:</strong> Benairco werkt niet in{' '}
                {excluded.join(', ')}.
              </span>
            </p>
          )
        }
      </div>

      <div class="aspect-[6/5] w-full overflow-hidden rounded-[var(--radius-image)] border border-[var(--color-border)]">
        <WerkgebiedMap />
      </div>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="container-content">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-serif text-2xl text-[var(--color-primary-900)] md:text-3xl">
          Alle plaatsen in het werkgebied
        </h2>
        <span class="text-sm text-[var(--color-muted)]">{cities.length} plaatsen</span>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-3 lg:grid-cols-4">
        {
          cities.map((city) => (
            <li class="flex items-center gap-2 border-b border-[var(--color-border)] py-2 text-[0.95rem]">
              <Icon
                name="check"
                class="size-3.5 shrink-0 text-[var(--color-accent-600)]"
              />
              {city}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
