---
import { site } from '~/config/site';

const lat = site.address.geo.latitude;
const lng = site.address.geo.longitude;
---

<div
  id="werkgebied-map"
  class="h-full w-full"
  data-lat={lat}
  data-lng={lng}
  data-place={site.address.city}
>
  <noscript>
    <div class="flex h-full w-full items-center justify-center bg-[var(--color-primary-50)] p-6 text-center text-sm text-[var(--color-muted)]">
      De interactieve kaart vereist JavaScript. Zie de plaatsenlijst hieronder.
    </div>
  </noscript>
</div>

<style is:global>
  /* Leaflet CSS — minimaal genoeg voor onze use case */
  @import 'leaflet/dist/leaflet.css';

  #werkgebied-map {
    border-radius: var(--radius-image);
    overflow: hidden;
    z-index: 0;
  }

  .benairco-pin {
    background: transparent;
    border: none;
  }

  .leaflet-popup-content-wrapper {
    border-radius: var(--radius-card);
    font-family: var(--font-sans);
  }

  .leaflet-popup-content {
    font-size: 0.875rem;
    margin: 0.75rem 1rem;
  }

  .leaflet-popup-content strong {
    color: var(--color-primary-900);
    font-family: var(--font-serif);
    font-size: 1rem;
  }

  .leaflet-container {
    background: var(--color-primary-50);
    font-family: var(--font-sans);
  }
</style>

<script>
  import L from 'leaflet';

  const container = document.getElementById('werkgebied-map');
  if (container) {
    const lat = parseFloat(container.dataset.lat ?? '51.9287');
    const lng = parseFloat(container.dataset.lng ?? '6.3502');
    const place = container.dataset.place ?? 'Gaanderen';

    const map = L.map(container, {
      center: [lat, lng],
      zoom: 10,
      scrollWheelZoom: false,
      zoomControl: true,
    });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>',
      maxZoom: 17,
    }).addTo(map);

    // Aangepaste pin matchend met site-stijl
    const pinSvg = `
      <svg width="32" height="42" viewBox="0 0 32 42" xmlns="http://www.w3.org/2000/svg" style="filter: drop-shadow(0 2px 3px rgba(0,0,0,0.3))">
        <path d="M16 0 C7 0 0 7 0 16 C0 28 16 42 16 42 C16 42 32 28 32 16 C32 7 25 0 16 0 Z" fill="#c47b3c"/>
        <circle cx="16" cy="16" r="6" fill="#fbfaf6"/>
      </svg>
    `;

    const pinIcon = L.divIcon({
      html: pinSvg,
      className: 'benairco-pin',
      iconSize: [32, 42],
      iconAnchor: [16, 42],
      popupAnchor: [0, -42],
    });

    L.marker([lat, lng], { icon: pinIcon })
      .addTo(map)
      .bindPopup(`<strong>Benairco</strong><br>${place}`);

    // 1-uur rijden radius (ca. 50 km)
    L.circle([lat, lng], {
      radius: 50000,
      color: '#c47b3c',
      weight: 1.5,
      dashArray: '6, 6',
      fillColor: '#c47b3c',
      fillOpacity: 0.04,
    }).addTo(map);
  }
</script>
