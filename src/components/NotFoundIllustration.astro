---
// 404-illustratie: airco buitenunit die los hangt aan kabels, met vraagtekens.
// Speels en thematisch passend bij Benairco.
---

<svg
  viewBox="0 0 400 360"
  xmlns="http://www.w3.org/2000/svg"
  class="h-full w-full"
  aria-hidden="true"
>
  <defs>
    <pattern id="nfDots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="var(--color-primary-700)" opacity="0.08"></circle>
    </pattern>
    <linearGradient id="nfBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-primary-50)"></stop>
      <stop offset="100%" stop-color="var(--color-paper)"></stop>
    </linearGradient>
  </defs>

  <rect width="400" height="360" fill="url(#nfBg)" rx="12"></rect>
  <rect width="400" height="360" fill="url(#nfDots)" rx="12"></rect>

  <!-- Muur-gedeelte links boven, met losgekomen beugel -->
  <g>
    <rect x="0" y="0" width="120" height="360" fill="var(--color-primary-100)" opacity="0.6"></rect>
    <line x1="120" y1="0" x2="120" y2="360" stroke="var(--color-primary-700)" stroke-width="1.5" opacity="0.3"></line>
    <!-- Lege boorgaten -->
    <circle cx="60" cy="100" r="3" fill="var(--color-primary-900)" opacity="0.4"></circle>
    <circle cx="80" cy="100" r="3" fill="var(--color-primary-900)" opacity="0.4"></circle>
    <circle cx="60" cy="160" r="3" fill="var(--color-primary-900)" opacity="0.4"></circle>
    <circle cx="80" cy="160" r="3" fill="var(--color-primary-900)" opacity="0.4"></circle>
    <!-- Losgekomen beugel -->
    <g transform="translate(60 100) rotate(-25)">
      <rect x="-2" y="0" width="4" height="60" fill="var(--color-primary-900)" opacity="0.7"></rect>
      <rect x="-8" y="58" width="40" height="6" fill="var(--color-primary-900)" opacity="0.7"></rect>
    </g>
  </g>

  <!-- Kabel + airco-unit zwevend -->
  <g>
    <!-- Twee kabels -->
    <path d="M 92 158 Q 130 200 180 240" fill="none" stroke="var(--color-primary-900)" stroke-width="2.5" stroke-linecap="round"></path>
    <path d="M 92 165 Q 140 210 200 240" fill="none" stroke="var(--color-accent-600)" stroke-width="2" stroke-linecap="round"></path>

    <!-- Buitenunit kantelt -->
    <g transform="translate(200 240) rotate(15)">
      <rect x="-50" y="-30" width="100" height="60" fill="var(--color-primary-700)" rx="4"></rect>
      <rect x="-46" y="-26" width="92" height="10" fill="var(--color-primary-900)" opacity="0.4"></rect>
      <circle cx="0" cy="5" r="14" fill="var(--color-paper)" opacity="0.85"></circle>
      <circle cx="0" cy="5" r="7" fill="var(--color-primary-900)"></circle>
      <!-- Ventilator-bladen -->
      <g stroke="var(--color-primary-900)" stroke-width="2" stroke-linecap="round" fill="none">
        <path d="M 0 -2 Q 4 -2 4 5"></path>
        <path d="M 0 12 Q -4 12 -4 5"></path>
        <path d="M -7 5 Q -7 1 0 1"></path>
      </g>
    </g>
  </g>

  <!-- Vraagtekens om de unit heen -->
  <g
    font-family="Georgia, serif"
    font-weight="700"
    fill="var(--color-accent-600)"
  >
    <text x="290" y="120" font-size="38" opacity="0.85" transform="rotate(15 290 120)">?</text>
    <text x="330" y="180" font-size="28" opacity="0.7" transform="rotate(-10 330 180)">?</text>
    <text x="270" y="80" font-size="22" opacity="0.5" transform="rotate(25 270 80)">?</text>
  </g>

  <!-- Vloer-schaduw -->
  <ellipse cx="200" cy="330" rx="100" ry="8" fill="var(--color-primary-900)" opacity="0.15"></ellipse>
</svg>
