---
type Variant = 'color' | 'mono' | 'white';

interface Props {
  /** Hoogte in pixels. */
  size?: number;
  /** Volledig logo met 'Warm in de winter | Koel in de zomer'. */
  withTagline?: boolean;
  variant?: Variant;
  class?: string;
}

const { size = 40, withTagline = false, variant = 'color', class: className = '' } = Astro.props;

// Verhoudingen volgen de viewBox van de SVG's in public/brand/
const ratio = withTagline ? 3340 / 1025 : 3340 / 825;
const base = withTagline ? 'benairco-logo' : 'benairco-wordmark';
const src = `/brand/${base}${variant === 'color' ? '' : `-${variant}`}.svg`;
---

<img
  src={src}
  alt="Benairco"
  width={Math.round(size * ratio)}
  height={size}
  class={`block ${className}`}
  decoding="async"
/>
