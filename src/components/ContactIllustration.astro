---
// Telefoon-met-bel-illustratie voor contactpagina.
// Suggestie: "even bellen", handpalm met smartphone, geluidsgolfjes, een keukentafel-context.
---

<svg
  viewBox="0 0 480 540"
  xmlns="http://www.w3.org/2000/svg"
  class="h-full w-full"
  aria-hidden="true"
>
  <defs>
    <pattern id="contactDots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="var(--color-primary-700)" opacity="0.08"></circle>
    </pattern>
    <linearGradient id="contactBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-primary-50)"></stop>
      <stop offset="100%" stop-color="var(--color-paper)"></stop>
    </linearGradient>
  </defs>

  <rect width="480" height="540" fill="url(#contactBg)" rx="12"></rect>
  <rect width="480" height="540" fill="url(#contactDots)" rx="12"></rect>

  <!-- Keukentafel-randje onderaan -->
  <rect x="0" y="450" width="480" height="90" fill="var(--color-primary-100)" opacity="0.5"></rect>
  <line x1="0" y1="450" x2="480" y2="450" stroke="var(--color-primary-700)" stroke-width="1.5" opacity="0.4"></line>

  <!-- Koffiekop op tafel -->
  <g transform="translate(80 410)">
    <ellipse cx="0" cy="40" rx="28" ry="6" fill="var(--color-primary-900)" opacity="0.15"></ellipse>
    <path d="M -22 0 L 22 0 L 18 40 L -18 40 Z" fill="var(--color-paper)" stroke="var(--color-primary-900)" stroke-width="2"></path>
    <path d="M 22 8 Q 36 8 36 20 Q 36 32 22 32" fill="none" stroke="var(--color-primary-900)" stroke-width="2"></path>
    <ellipse cx="0" cy="0" rx="22" ry="4" fill="var(--color-accent-600)" opacity="0.6"></ellipse>
    <!-- Stoom -->
    <g stroke="var(--color-primary-700)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.4">
      <path d="M -8 -8 Q -4 -16 -8 -24 Q -12 -32 -8 -40"></path>
      <path d="M 0 -10 Q 4 -18 0 -26 Q -4 -34 0 -42"></path>
      <path d="M 8 -8 Q 12 -16 8 -24 Q 4 -32 8 -40"></path>
    </g>
  </g>

  <!-- Notitieboekje op tafel -->
  <g transform="translate(330 430) rotate(-6)">
    <rect x="0" y="0" width="100" height="50" fill="var(--color-paper)" stroke="var(--color-primary-900)" stroke-width="2" rx="2"></rect>
    <line x1="10" y1="14" x2="80" y2="14" stroke="var(--color-primary-700)" stroke-width="1.5" opacity="0.5"></line>
    <line x1="10" y1="24" x2="70" y2="24" stroke="var(--color-primary-700)" stroke-width="1.5" opacity="0.5"></line>
    <line x1="10" y1="34" x2="76" y2="34" stroke="var(--color-primary-700)" stroke-width="1.5" opacity="0.5"></line>
    <!-- Spiraal-binding -->
    <g fill="var(--color-primary-900)">
      <circle cx="-2" cy="10" r="2"></circle>
      <circle cx="-2" cy="25" r="2"></circle>
      <circle cx="-2" cy="40" r="2"></circle>
    </g>
  </g>

  <!-- Smartphone (centraal, gekanteld) -->
  <g transform="translate(240 250) rotate(-8)">
    <!-- Phone body -->
    <rect x="-70" y="-130" width="140" height="260" fill="var(--color-primary-900)" rx="18"></rect>
    <rect x="-62" y="-118" width="124" height="236" fill="var(--color-primary-50)" rx="10"></rect>

    <!-- Notch -->
    <rect x="-18" y="-130" width="36" height="8" fill="var(--color-primary-900)" rx="4"></rect>

    <!-- Contact-screen content -->
    <g transform="translate(0 -90)">
      <!-- Avatar -->
      <circle cx="0" cy="0" r="22" fill="var(--color-accent)" opacity="0.25"></circle>
      <circle cx="0" cy="0" r="18" fill="var(--color-accent-600)"></circle>
      <text
        x="0"
        y="5"
        font-family="Georgia, serif"
        font-size="20"
        font-weight="700"
        fill="var(--color-paper)"
        text-anchor="middle"
      >
        B
      </text>
      <!-- Naam -->
      <text
        x="0"
        y="42"
        font-family="Inter, system-ui, sans-serif"
        font-size="10"
        font-weight="600"
        fill="var(--color-primary-900)"
        text-anchor="middle"
      >
        Ben Vrieze
      </text>
      <text
        x="0"
        y="55"
        font-family="Inter, system-ui, sans-serif"
        font-size="8"
        fill="var(--color-primary-700)"
        text-anchor="middle"
        opacity="0.7"
      >
        Benairco · Gaanderen
      </text>
    </g>

    <!-- Inkomende-oproep status -->
    <text
      x="0"
      y="0"
      font-family="Inter, system-ui, sans-serif"
      font-size="9"
      fill="var(--color-primary-700)"
      text-anchor="middle"
      opacity="0.7"
    >
      Inkomende oproep
    </text>

    <!-- Antwoord/afwijzen knoppen -->
    <g transform="translate(0 70)">
      <circle cx="-32" cy="0" r="20" fill="#dc2626"></circle>
      <path d="M -40 -2 L -24 -2 L -32 6 Z" fill="white"></path>

      <circle cx="32" cy="0" r="20" fill="#16a34a"></circle>
      <g transform="translate(32 0) scale(0.55)" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M 16 16.92 v 3 a 2 2 0 0 1 -2.18 2 19.79 19.79 0 0 1 -8.63 -3.07 19.5 19.5 0 0 1 -6 -6 19.79 19.79 0 0 1 -3.07 -8.67 A 2 2 0 0 1 -1.89 2 h 3 a 2 2 0 0 1 2 1.72 c 0.13 0.96 0.37 1.9 0.72 2.81 a 2 2 0 0 1 -0.45 2.11 L 2.09 9.91 a 16 16 0 0 0 6 6 l 1.27 -1.27 a 2 2 0 0 1 2.11 -0.45 c 0.91 0.35 1.85 0.59 2.81 0.72 A 2 2 0 0 1 16 16.92 z" />
      </g>
    </g>
  </g>

  <!-- Geluidsgolfjes naast telefoon -->
  <g stroke="var(--color-accent)" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.7">
    <path d="M 380 180 Q 395 200 380 220" />
    <path d="M 400 160 Q 425 200 400 240" />
    <path d="M 420 140 Q 455 200 420 260" />
  </g>
  <g stroke="var(--color-accent)" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.7">
    <path d="M 100 180 Q 85 200 100 220" />
    <path d="M 80 160 Q 55 200 80 240" />
    <path d="M 60 140 Q 25 200 60 260" />
  </g>
</svg>
