---
import { site } from '~/config/site';
import Logo from '~/components/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--color-border)] bg-white">
  <div class="container-content grid gap-10 py-12 md:grid-cols-3">
    <div>
      <h2>
        <Logo size={40} />
      </h2>
      <p class="mt-3 max-w-xs text-sm text-[var(--color-muted)]">
        {site.tagline}. Persoonlijk, netjes, betaalbaar. Uit Gaanderen, voor de Achterhoek en Twente.
      </p>
    </div>

    <div>
      <h3 class="font-serif text-base font-semibold text-[var(--color-primary-900)]">
        Contact
      </h3>
      <ul class="mt-3 space-y-1.5 text-sm">
        <li>
          <a
            href={`mailto:${site.contact.email}`}
            class="hover:text-[var(--color-accent-600)]"
          >
            {site.contact.email}
          </a>
        </li>
        <li class="text-[var(--color-muted)]">
          {site.address.street}<br />
          {site.address.postalCode} {site.address.city}
        </li>
      </ul>
    </div>

    <div>
      <h3 class="font-serif text-base font-semibold text-[var(--color-primary-900)]">
        STEK-gecertificeerd
      </h3>
      <p class="mt-3 text-sm text-[var(--color-muted)]">
        {site.name} is een STEK-gecertificeerd installatiebedrijf{site.business.stekNumber && (
          <> (erkenningsnummer {site.business.stekNumber})</>
        )}. Airco's en warmtepompen worden geplaatst en onderhouden volgens de F-gassenregels.
      </p>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)]">
    <div
      class="container-content flex flex-col items-start justify-between gap-3 py-4 text-xs text-[var(--color-muted)] md:flex-row md:items-center"
    >
      <p>
        © {year} {site.legalName} · KvK {site.business.kvk} ·
        <span class="block md:inline">{site.legalNotice}</span>
      </p>
      <ul class="flex items-center gap-5">
        <li><a href="/privacy" class="hover:text-[var(--color-accent-600)]">Privacy</a></li>
        <li><a href="/voorwaarden" class="hover:text-[var(--color-accent-600)]">Voorwaarden</a></li>
      </ul>
    </div>
  </div>
</footer>
