---
import Icon from '~/components/Icon.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  location: string;
  woningtype: string;
  bouwjaar?: string;
  toestel: string;
  type: 'single-split' | 'multi-split' | 'lucht-lucht warmtepomp';
  capaciteit: string;
  aantalUnits: number;
  doorlooptijd: string;
  isVoorbeeld?: boolean;
  /** Base URL voor de detail-link (default: /kennisbank/voorbeelden). */
  baseUrl?: string;
}

const {
  id,
  title,
  description,
  location,
  woningtype,
  toestel,
  type,
  capaciteit,
  doorlooptijd,
  baseUrl = '/kennisbank/voorbeelden',
} = Astro.props;

const typeLabel: Record<Props['type'], string> = {
  'single-split': 'Single-split',
  'multi-split': 'Multi-split',
  'lucht-lucht warmtepomp': 'Warmtepomp',
};
---

<a
  href={`${baseUrl}/${id}`}
  class="group block rounded-[var(--radius-card)] border border-[var(--color-border)] bg-white p-7 transition-colors hover:border-[var(--color-primary-700)] md:p-8"
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs">
    <span class="font-semibold uppercase tracking-wider text-[var(--color-muted)]">
      {location} · {woningtype}
    </span>
    <span class="font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
      {typeLabel[type]}
    </span>
  </div>

  <h3 class="mt-3 font-serif text-xl leading-snug text-[var(--color-primary-900)] group-hover:text-[var(--color-accent-600)] md:text-2xl">
    {title}
  </h3>

  <p class="mt-3 text-[0.95rem] leading-7 text-[var(--color-ink)]">
    {description}
  </p>

  <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-xs text-[var(--color-muted)]">
    <div>
      <dt class="inline font-semibold text-[var(--color-primary-900)]">Toestel:</dt>
      <dd class="inline">{toestel}</dd>
    </div>
    <div>
      <dt class="inline font-semibold text-[var(--color-primary-900)]">Capaciteit:</dt>
      <dd class="inline">{capaciteit}</dd>
    </div>
    <div>
      <dt class="inline font-semibold text-[var(--color-primary-900)]">Doorlooptijd:</dt>
      <dd class="inline">{doorlooptijd}</dd>
    </div>
  </dl>

  <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent-600)]">
    Lees meer
    <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
  </span>
</a>
