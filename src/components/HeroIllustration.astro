---
// Decoratieve hero-illustratie: gestileerd huis met airco-unit en luchtstroom-curves.
// Geen foto — past bij soft-launch waarbij echte foto's nog volgen.
---

<svg
  viewBox="0 0 480 600"
  xmlns="http://www.w3.org/2000/svg"
  class="h-full w-full"
  aria-hidden="true"
>
  <!-- Achtergrond met subtiele rasterstippen -->
  <defs>
    <pattern id="dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="var(--color-primary-700)" opacity="0.08"></circle>
    </pattern>
    <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-primary-50)"></stop>
      <stop offset="100%" stop-color="var(--color-paper)"></stop>
    </linearGradient>
  </defs>

  <rect width="480" height="600" fill="url(#skyGrad)" rx="12"></rect>
  <rect width="480" height="600" fill="url(#dots)" rx="12"></rect>

  <!-- Heuvels achter het huis -->
  <path
    d="M0 470 Q 120 420 240 450 T 480 440 L 480 600 L 0 600 Z"
    fill="var(--color-primary-100)"
    opacity="0.7"
  ></path>
  <path
    d="M0 510 Q 140 480 280 500 T 480 495 L 480 600 L 0 600 Z"
    fill="var(--color-primary-100)"
  ></path>

  <!-- Boom (suggestie van Achterhoek-landschap) -->
  <g transform="translate(60 380)">
    <rect x="-3" y="40" width="6" height="50" fill="var(--color-primary-900)" opacity="0.4"></rect>
    <circle cx="0" cy="30" r="32" fill="var(--color-primary-700)" opacity="0.5"></circle>
    <circle cx="-18" cy="50" r="22" fill="var(--color-primary-700)" opacity="0.5"></circle>
    <circle cx="20" cy="48" r="20" fill="var(--color-primary-700)" opacity="0.5"></circle>
  </g>

  <!-- Huis -->
  <g transform="translate(150 200)">
    <!-- Dak -->
    <path
      d="M -20 110 L 100 20 L 220 110 Z"
      fill="var(--color-primary-900)"
    ></path>
    <!-- Muur -->
    <rect x="0" y="100" width="200" height="200" fill="var(--color-paper)" stroke="var(--color-primary-900)" stroke-width="2.5"></rect>
    <!-- Deur -->
    <rect x="86" y="200" width="36" height="100" fill="var(--color-primary-900)"></rect>
    <circle cx="115" cy="250" r="2" fill="var(--color-accent)"></circle>
    <!-- Raam links -->
    <rect x="22" y="135" width="46" height="46" fill="var(--color-primary-50)" stroke="var(--color-primary-900)" stroke-width="2"></rect>
    <line x1="45" y1="135" x2="45" y2="181" stroke="var(--color-primary-900)" stroke-width="2"></line>
    <line x1="22" y1="158" x2="68" y2="158" stroke="var(--color-primary-900)" stroke-width="2"></line>
    <!-- Raam rechts -->
    <rect x="132" y="135" width="46" height="46" fill="var(--color-primary-50)" stroke="var(--color-primary-900)" stroke-width="2"></rect>
    <line x1="155" y1="135" x2="155" y2="181" stroke="var(--color-primary-900)" stroke-width="2"></line>
    <line x1="132" y1="158" x2="178" y2="158" stroke="var(--color-primary-900)" stroke-width="2"></line>
    <!-- Schoorsteen -->
    <rect x="155" y="35" width="18" height="40" fill="var(--color-primary-900)"></rect>

    <!-- Airco buitenunit aan rechterzijde -->
    <g transform="translate(210 140)">
      <rect x="0" y="0" width="46" height="32" fill="var(--color-primary-700)" rx="3"></rect>
      <rect x="3" y="3" width="40" height="6" fill="var(--color-primary-900)" opacity="0.4"></rect>
      <circle cx="23" cy="20" r="6" fill="var(--color-paper)" opacity="0.85"></circle>
      <circle cx="23" cy="20" r="3" fill="var(--color-primary-900)"></circle>
      <!-- Bevestigingsbeugel -->
      <rect x="-4" y="6" width="4" height="20" fill="var(--color-primary-900)" opacity="0.6"></rect>
    </g>
  </g>

  <!-- Luchtstroom-curves vanaf de airco-unit -->
  <g stroke="var(--color-accent)" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.7">
    <path d="M 410 350 Q 430 340 425 320" />
    <path d="M 410 360 Q 440 350 442 325" />
    <path d="M 410 370 Q 450 360 458 330" />
  </g>

  <!-- Sneeuwvlokjes (suggestie van koelen) -->
  <g fill="var(--color-accent)" opacity="0.6">
    <circle cx="438" cy="295" r="3"></circle>
    <circle cx="455" cy="310" r="2"></circle>
    <circle cx="445" cy="278" r="2"></circle>
  </g>
</svg>
