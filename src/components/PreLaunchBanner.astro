---
import { site } from '~/config/site';

const launchLabel = site.business.expectedHardLaunchLabel;
---

<div class="bg-[var(--color-primary-50)] border-b border-[var(--color-border)]">
  <p class="container-content py-2 text-center text-sm text-[var(--color-primary-900)]">
    <span class="font-semibold">Bijna open.</span>
    Benairco start zijn dienstverlening in
    <span class="font-semibold">{launchLabel}</span>. Tot dan welkom voor advies en kennismaking.
  </p>
</div>
