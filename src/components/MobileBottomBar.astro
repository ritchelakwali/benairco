---
import { site } from '~/config/site';

const mailHref = `mailto:${site.contact.email}`;
---

<div
  class="fixed inset-x-0 bottom-0 z-50 flex border-t border-[var(--color-border)] bg-white shadow-[0_-2px_8px_rgba(0,0,0,0.04)] md:hidden"
  role="navigation"
  aria-label="Snelle contactopties"
>
  <a
    href={mailHref}
    class="flex flex-1 items-center justify-center gap-2 bg-[var(--color-accent)] py-3 font-semibold text-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
      aria-hidden="true"
    >
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
    </svg>
    Mail ons
  </a>
</div>

<div class="h-14 md:hidden" aria-hidden="true"></div>
