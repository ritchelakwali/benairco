---
import Icon from '~/components/Icon.astro';
import { site } from '~/config/site';

const steps = [
  {
    icon: 'mail' as const,
    title: 'Mail ons',
    body: 'Geen ingewikkeld formulier. Mail Ben rechtstreeks en je krijgt persoonlijk antwoord voor een eerste, vrijblijvend gesprek.',
  },
  {
    icon: 'home' as const,
    title: 'Kennismaking bij jou thuis',
    body: 'Gratis opname op locatie. Samen lopen we door je woning om te kijken wat past, qua vermogen, plaatsing en wensen.',
  },
  {
    icon: 'mail' as const,
    title: 'Heldere offerte',
    body: 'Op papier zwart-op-wit wat je krijgt: toestel, leidingwerk, installatie, garantie. Geen meerwerk-verrassingen.',
  },
  {
    icon: 'tools' as const,
    title: 'Installatie in één dag',
    body: 'Een single-split zit binnen één werkdag. Een vakman uit ons vaste team komt langs.',
  },
  {
    icon: 'shield' as const,
    title: 'Uitleg + onderhoud',
    body: 'Wij leggen persoonlijk uit hoe je het toestel optimaal gebruikt en plannen indien gewenst het jaarlijkse onderhoud in.',
  },
];
---

<section class="bg-[var(--color-paper)] py-16 md:py-24">
  <div class="container-content">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--color-accent-600)]">
        Zo gaat het werken vanaf {site.business.expectedHardLaunchLabel}
      </p>
      <h2 class="mt-2 font-serif text-2xl text-[var(--color-primary-900)] md:text-3xl">
        Van eerste bericht tot draaiende airco
      </h2>
      <p class="mt-3 text-[var(--color-muted)]">
        Vijf stappen, geen verkooptraject, geen pushy commerciële druk. In aanloop
        naar de opening kun je nu al kennismaken of een voorlopige reservering
        plaatsen.
      </p>
    </div>

    <ol class="mt-12 grid gap-6 md:grid-cols-5 md:gap-4">
      {
        steps.map((step, idx) => (
          <li>
            <div class="flex items-start gap-4 md:flex-col md:items-stretch">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-50)] text-[var(--color-primary-700)]">
                <Icon name={step.icon} class="size-5" />
              </div>
              <div class="md:mt-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">
                  Stap {idx + 1}
                </p>
                <h3 class="mt-1 font-serif text-lg text-[var(--color-primary-900)]">
                  {step.title}
                </h3>
                <p class="mt-1.5 text-[0.95rem] text-[var(--color-ink)]">{step.body}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
