  leaf: '<path d="M11 20A7 7 0 0 1 4 13c0-7 8-9 17-9-1 6 0 14-7 16h-3z"></path><path d="M2 22l8-8"></path>',
  route:
    '<circle cx="6" cy="19" r="3"></circle><circle cx="18" cy="5" r="3"></circle><path d="M9 19h7a4 4 0 0 0 0-8h-8a4 4 0 0 1 0-8h7"></path>',
  snowflake:
    '<line x1="12" y1="2" x2="12" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line><line x1="19.07" y1="4.93" x2="4.93" y2="19.07"></line>',
