---
/**
 * Inline SVG-iconenset. Geen externe library, alles bundelt mee in de HTML.
 * Voeg een icoon toe door een nieuwe key aan `paths` en `viewBoxes` te hangen.
 */
interface Props {
  name:
    | 'check'
    | 'phone'
    | 'whatsapp'
    | 'home'
    | 'calendar'
    | 'shield'
    | 'star'
    | 'tools'
    | 'heart'
    | 'leaf'
    | 'route'
    | 'snowflake'
    | 'flame'
    | 'arrow-right'
    | 'mail';
  class?: string;
  size?: number;
}

const { name, class: className = 'size-5', size } = Astro.props;

const viewBoxes: Record<Props['name'], string> = {
  check: '0 0 24 24',
  phone: '0 0 24 24',
  whatsapp: '0 0 24 24',
  home: '0 0 24 24',
  calendar: '0 0 24 24',
  shield: '0 0 24 24',
  star: '0 0 24 24',
  tools: '0 0 24 24',
  heart: '0 0 24 24',
  leaf: '0 0 24 24',
  route: '0 0 24 24',
  snowflake: '0 0 24 24',
  flame: '0 0 24 24',
  'arrow-right': '0 0 24 24',
  mail: '0 0 24 24',
};

const paths: Record<Props['name'], string> = {
