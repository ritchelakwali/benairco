---
interface Props {
  category: 'subsidie' | 'techniek' | 'onderhoud' | 'kosten' | 'verhaal';
  class?: string;
}

const { category, class: className = '' } = Astro.props;

// Eén bron van waarheid voor categorie-presentatie.
// Iconen zijn inline SVG-paths om de Icon-component lichtgewicht te houden.
const meta: Record<
  Props['category'],
  { label: string; iconPath: string; viewBox?: string }
> = {
  subsidie: {
    label: 'Subsidie',
    // Euro-teken in cirkel
    iconPath:
      '<circle cx="12" cy="12" r="10"></circle><path d="M16 8.5C14.5 7 12.5 6.5 11 7.5C9 8.5 8 11 8 13C8 15 9 17.5 11 18.5C12.5 19.5 14.5 19 16 17.5"></path><line x1="6.5" y1="11" x2="13" y2="11"></line><line x1="6.5" y1="13.5" x2="12.5" y2="13.5"></line>',
  },
  techniek: {
    label: 'Techniek',
    // Tandwiel
    iconPath:
      '<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>',
  },
  onderhoud: {
    label: 'Onderhoud',
    // Schroevendraaier
    iconPath:
      '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>',
  },
  kosten: {
    label: 'Kosten',
    // Bonnetje
    iconPath:
      '<path d="M4 4h16v18l-3-2-3 2-3-2-3 2-4-2V4z"></path><line x1="8" y1="9" x2="16" y2="9"></line><line x1="8" y1="13" x2="14" y2="13"></line>',
  },
  verhaal: {
    label: 'Verhaal',
    // Speech bubble
    iconPath:
      '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>',
  },
};

const m = meta[category];
---

<span
  class={`inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-[var(--color-accent-600)] ${className}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox={m.viewBox ?? '0 0 24 24'}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-3.5"
    aria-hidden="true"
    set:html={m.iconPath}
  />
  {m.label}
</span>
