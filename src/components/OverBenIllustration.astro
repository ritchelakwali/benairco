---
// Abstracte werkplaats-illustratie voor over-ben pagina.
// Silhouet van een vakman zonder gezichtskenmerken, geen claim dat het Ben is,
// maar geeft de pagina karakter waar nu een grijze placeholder staat.
---

<svg
  viewBox="0 0 480 600"
  xmlns="http://www.w3.org/2000/svg"
  class="h-full w-full"
  aria-hidden="true"
>
  <defs>
    <pattern id="benDots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="2" cy="2" r="1" fill="var(--color-primary-700)" opacity="0.08"></circle>
    </pattern>
    <linearGradient id="benBg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-primary-50)"></stop>
      <stop offset="100%" stop-color="var(--color-paper)"></stop>
    </linearGradient>
  </defs>

  <rect width="480" height="600" fill="url(#benBg)" rx="12"></rect>
  <rect width="480" height="600" fill="url(#benDots)" rx="12"></rect>

  <!-- Vloer -->
  <line x1="0" y1="500" x2="480" y2="500" stroke="var(--color-primary-900)" stroke-width="2" opacity="0.6"></line>

  <!-- Schap/plank rechts met gereedschap -->
  <g opacity="0.55">
    <line x1="320" y1="150" x2="450" y2="150" stroke="var(--color-primary-900)" stroke-width="2"></line>
    <!-- Sleutel -->
    <g transform="translate(335 120) rotate(-15)">
      <circle cx="0" cy="0" r="7" fill="none" stroke="var(--color-primary-900)" stroke-width="2"></circle>
      <rect x="-1.5" y="6" width="3" height="22" fill="var(--color-primary-900)"></rect>
    </g>
    <!-- Schroevendraaier -->
    <g transform="translate(370 122)">
      <rect x="-2" y="0" width="4" height="22" fill="var(--color-primary-900)"></rect>
      <rect x="-4" y="-6" width="8" height="8" fill="var(--color-accent-600)" rx="1"></rect>
    </g>
    <!-- Tang -->
    <g transform="translate(410 125) rotate(20)">
      <path d="M -2 0 L 2 0 L 6 22 L -6 22 Z" fill="var(--color-primary-900)"></path>
      <circle cx="0" cy="0" r="3" fill="none" stroke="var(--color-primary-900)" stroke-width="1.5"></circle>
    </g>
  </g>

  <!-- Airco binnenunit aan de muur (links boven) -->
  <g transform="translate(60 130)">
    <rect x="0" y="0" width="120" height="34" fill="var(--color-paper)" stroke="var(--color-primary-900)" stroke-width="2" rx="4"></rect>
    <rect x="6" y="22" width="108" height="6" fill="var(--color-primary-700)" opacity="0.3"></rect>
    <rect x="98" y="4" width="18" height="6" fill="var(--color-primary-900)" opacity="0.4" rx="1"></rect>
    <!-- Status-LED -->
    <circle cx="14" cy="8" r="2" fill="var(--color-accent)"></circle>
  </g>

  <!-- Subtiele luchtstroom -->
  <g stroke="var(--color-accent)" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.5">
    <path d="M 80 175 Q 85 190 80 205" />
    <path d="M 110 175 Q 115 195 110 215" />
    <path d="M 140 175 Q 145 195 140 215" />
  </g>

  <!-- Vakman silhouet (geen gezichtskenmerken, abstracte werkster-figuur) -->
  <g transform="translate(180 220)">
    <!-- Hoofd -->
    <circle cx="60" cy="40" r="36" fill="var(--color-primary-900)"></circle>
    <!-- Pet/kapje -->
    <path d="M 24 30 Q 30 10 60 8 Q 92 10 96 30 L 96 36 L 24 36 Z" fill="var(--color-primary-900)"></path>
    <path d="M 24 36 L 14 42 L 14 38 L 24 32 Z" fill="var(--color-primary-900)"></path>

    <!-- Lichaam / bodywarmer -->
    <path d="M 22 90 Q 22 80 36 76 L 84 76 Q 98 80 98 90 L 100 200 Q 100 220 60 220 Q 20 220 20 200 Z"
          fill="var(--color-primary-700)"></path>
    <!-- T-shirt eronder -->
    <path d="M 36 76 L 84 76 L 90 95 L 90 130 L 30 130 L 30 95 Z" fill="var(--color-paper)" opacity="0.9"></path>
    <line x1="60" y1="76" x2="60" y2="130" stroke="var(--color-primary-900)" stroke-width="1" opacity="0.3"></line>

    <!-- Linker arm naar beneden -->
    <path d="M 22 96 Q 6 130 4 180 L 24 184 Q 28 140 38 110 Z" fill="var(--color-primary-700)"></path>
    <!-- Hand links -->
    <circle cx="14" cy="190" r="11" fill="var(--color-paper)" stroke="var(--color-primary-900)" stroke-width="1.5"></circle>

    <!-- Rechter arm omhoog (vasthouden gereedschap) -->
    <path d="M 98 96 Q 130 100 145 70 L 130 60 Q 120 80 90 92 Z" fill="var(--color-primary-700)"></path>
    <!-- Hand rechts met sleutel -->
    <circle cx="145" cy="68" r="10" fill="var(--color-paper)" stroke="var(--color-primary-900)" stroke-width="1.5"></circle>
    <g transform="translate(155 50) rotate(40)">
      <circle cx="0" cy="0" r="6" fill="none" stroke="var(--color-primary-900)" stroke-width="2.5"></circle>
      <rect x="-2" y="5" width="4" height="22" fill="var(--color-primary-900)"></rect>
      <rect x="-4" y="25" width="8" height="4" fill="var(--color-accent-600)"></rect>
    </g>

    <!-- Broek -->
    <path d="M 24 218 L 50 218 L 50 290 L 30 290 Z" fill="var(--color-primary-900)"></path>
    <path d="M 70 218 L 96 218 L 90 290 L 70 290 Z" fill="var(--color-primary-900)"></path>
    <!-- Schoenen -->
    <rect x="22" y="285" width="32" height="14" fill="var(--color-primary-900)" rx="2"></rect>
    <rect x="66" y="285" width="32" height="14" fill="var(--color-primary-900)" rx="2"></rect>

    <!-- Bedrijfsnaam op bodywarmer -->
    <text
      x="60"
      y="170"
      font-family="Georgia, serif"
      font-size="13"
      font-weight="600"
      fill="var(--color-paper)"
      text-anchor="middle"
      opacity="0.9"
    >
      Benairco
    </text>
  </g>

  <!-- Schaduw onder figuur -->
  <ellipse cx="240" cy="510" rx="80" ry="6" fill="var(--color-primary-900)" opacity="0.2"></ellipse>
</svg>
